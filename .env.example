# API defaults bind to loopback and enable local synthetic demo only.
PORT=4000
HOST=127.0.0.1
DEMO_MODE=true
DATABASE_PATH=./data/rescuerelay.db
WEB_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Explicitly opt in before exposing the local demo to a private phone-test LAN.
ALLOW_LAN_DEMO=false
# Provider mode remains offline unless configured AND explicitly requested.
REASONING_PROVIDER=offline
# Legacy REASONING_PROVIDER is retained for old config readability but does not activate external calls.
# Use the optional AI workspace with global/per-provider flags and per-operation consent below.
# OPENAI_API_KEY= supply your own; never commit secrets
# OPENAI_MODEL= choose a model supported by your account

# Optional AI workspace: every integration OFF by default.
# Enabling these flags is an operator decision, NOT evidence of approved live use.
# Each actual operation also requires a fresh, explicit data-transfer consent.
AI_EXTERNAL_CALLS_ENABLED=false
FIREWORKS_ENABLED=false
# FIREWORKS_API_KEY=
# FIREWORKS_MODEL=explicit-model-available-in-your-account
NEBIUS_ENABLED=false
# NEBIUS_API_KEY=
# NEBIUS_MODEL=explicit-model-available-in-your-account
OPENAI_ENABLED=false
# OPENAI_API_KEY and OPENAI_MODEL above are used only through the consent workflow.
PINECONE_ENABLED=false
# PINECONE_API_KEY=
# PINECONE_INDEX_HOST=your-existing-documents-index.svc.region.pinecone.io
TAVILY_ENABLED=false
# TAVILY_API_KEY=
TAVILY_ALLOWED_DOMAINS=usda.gov,fda.gov,foodrescuehero.org,foodrescue.us
MEM0_ENABLED=false
# MEM0_API_KEY=
LANGSMITH_ENABLED=false
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=your-existing-project
# LANGSMITH_WORKSPACE_ID=only-if-required-for-a-multiworkspace-key
LLAMAPARSE_ENABLED=false
# LLAMA_CLOUD_API_KEY=
# LLAMAPARSE_TIER=explicit-supported-markdown-tier-not-fast
# LLAMAPARSE_VERSION=explicit-supported-version
ELEVENLABS_ENABLED=false
# ELEVENLABS_API_KEY=
# ELEVENLABS_STT_MODEL=scribe_v2
# Uploaded file limits are bytes/request limits, NOT page/duration/dollar caps.
# Review vendor-side spend controls, retention, data permissions and model access first.
KEENABLE_ENABLED=false
# KEENABLE_API_KEY=
# Keenable is an explicitly selected alternative to Tavily, never an automatic fallback.
